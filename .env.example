# Copy this file to ".env" and fill in your real keys.
# NEVER commit the real ".env" file to version control.

# Google AI Studio (Gemini) key: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# OpenAI key (optional alternative to Gemini): https://platform.openai.com/api-keys
OPENAI_API_KEY=your_openai_api_key_here

# Base URL if you proxy AI calls through your own backend / Cloud Function
AI_PROXY_BASE_URL=https://your-cloud-function-url.cloudfunctions.net
